# Copy to .env:  cp .env.example .env
# Shared by ml-service (Python) and api (Next.js).

# --- LLM: pick ONE provider; it is used exclusively for the whole run ---------
# anthropic -> Claude Sonnet 4.6 via API (needs ANTHROPIC_API_KEY)
# ollama    -> local qwen2.5-coder:7b via Ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Ollama address when running without Docker
OLLAMA_BASE_URL=http://localhost:11434
# Ollama address as seen from the Docker container (docker compose). Default when unset:
# http://host.docker.internal:11434 (Ollama on this machine). For a shared server: http://<host>:11434
# OLLAMA_BASE_URL_DOCKER=http://ollama-server.mycompany.local:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# CPU-only Ollama can take minutes per request: raise this and UPSTREAM_TIMEOUT_SECONDS together
LLM_TIMEOUT_SECONDS=90

# --- Recommendations ----------------------------------------------------------
# Default number of products returned (a request may pass "limit" up to MAX_RECOMMENDATION_COUNT)
RECOMMENDATION_COUNT=5
MAX_RECOMMENDATION_COUNT=20
# How many top XGBoost candidates the LLM chooses from
CANDIDATE_POOL_SIZE=15
# Hide products the member already bought
EXCLUDE_PURCHASED_PRODUCTS=true
# Reload orders from Postgres after this many seconds (no retrain needed)
DATA_REFRESH_SECONDS=300
# Cache each member's recommendations (LLM calls are slow)
CACHE_TTL_SECONDS=600
# Retrain on every start instead of loading ml-service/artifacts/
RETRAIN_ON_STARTUP=false

# --- PostgreSQL (the shoppingwebsite database, port 5432) ---------------------
POSTGRES_USER=shopping
POSTGRES_PASSWORD=shopping
POSTGRES_DB=shoppingwebsite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Next.js API --------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
# Angular dev server and the Spring Boot-served production build
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
UPSTREAM_TIMEOUT_SECONDS=120
